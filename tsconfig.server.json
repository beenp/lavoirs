    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "api/livekit/token.ts",
        "server/**/*.ts",
        "packages/shared/src/**/*.ts"
    ]
